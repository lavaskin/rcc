<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rcc</AssemblyName>
    <RootNamespace>ReviewClips.Cli</RootNamespace>
    <RollForward>latestMinor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReviewClips.Core\ReviewClips.Core.csproj" />
    <ProjectReference Include="..\ReviewClips.Ffmpeg\ReviewClips.Ffmpeg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The option surface and the request builder are internal, and should stay that way: nothing
    outside this assembly has any business constructing them. But they hold the whole of the
    input validation, which is exactly what most wants testing, so the test assembly is let in
    rather than the types being widened for its benefit.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ReviewClips.Cli.Tests" />
  </ItemGroup>

</Project>
